          <zone h="19798" id="8" w="50000" x="50000" y="79192" type="text">
            <formatted-text>
              <run fontsize="13" fontcolor="#0b0b0b" bold="true">Who is slipping away?
</run>
              <run fontsize="11" fontcolor="#52514e">Need Attention, About to Sleep, At Risk and Can't Lose Them. 142 days is twice the 71-day upper end of a typical reorder gap. Many At Risk customers have been silent 6-13 months and may already be lost.</run>
            </formatted-text>
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
