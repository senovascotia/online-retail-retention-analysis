  <worksheets>
    <worksheet name="T Gross sales">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#52514e" fontsize="10">Gross sales, Dec 2009 to 9 Dec 2011</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Headline KPIs" name="kpis" />
          </datasources>
          <datasource-dependencies datasource="kpis">
            <column datatype="real" name="[gross_sales_m]" role="measure" type="quantitative" aggregation="Sum" />
            <column-instance column="[gross_sales_m]" derivation="Sum" name="[sum:gross_sales_m:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" value="*£0.0&quot;M&quot;" field="[kpis].[sum:gross_sales_m:qk]" />
            <format attr="text-align" value="center" field="[kpis].[sum:gross_sales_m:qk]" />
            <format attr="font-size" value="26" field="[kpis].[sum:gross_sales_m:qk]" />
            <format attr="font-weight" value="bold" field="[kpis].[sum:gross_sales_m:qk]" />
            <format attr="color" value="#0b0b0b" field="[kpis].[sum:gross_sales_m:qk]" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[kpis].[sum:gross_sales_m:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="T Tracked customers">
      <layout-options>
