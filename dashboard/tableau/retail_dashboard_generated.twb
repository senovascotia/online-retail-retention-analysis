  <datasources>
    <datasource caption="Headline KPIs" inline="true" name="kpis" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection name="kpis_leaf">
            <connection character-set="UTF-8" class="textscan" directory="D:/project-repo/data-analyst-portfolio/dashboard/tableau/data" driver="" filename="headline_kpis.csv" force-character-set="no" force-header="no" force-separator="no" header="yes" separator="," text-qualifier="&quot;" />
          </named-connection>
        </named-connections>
        <relation connection="kpis_leaf" name="headline_kpis#csv" table="[headline_kpis#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="real" name="gross_sales" ordinal="0" />
            <column datatype="integer" name="tracked_customers" ordinal="1" />
            <column datatype="real" name="repeat_rate" ordinal="2" />
            <column datatype="real" name="sales_growth" ordinal="3" />
