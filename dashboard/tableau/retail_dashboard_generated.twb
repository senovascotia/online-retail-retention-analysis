            <column datatype="real" name="slipping_revenue_share" ordinal="7" />
            <column datatype="integer" name="quiet_customers" ordinal="8" />
            <column datatype="real" name="quiet_lifetime_sales" ordinal="9" />
            <column datatype="integer" name="flagged_customers" ordinal="10" />
            <column datatype="real" name="flagged_sales" ordinal="11" />
            <column datatype="real" name="expected_loss" ordinal="12" />
            <column datatype="integer" name="top_tier_customers" ordinal="13" />
            <column datatype="real" name="top_tier_sales" ordinal="14" />
            <column datatype="real" name="gross_sales_m" ordinal="15" />
            <column datatype="real" name="slipping_revenue_m" ordinal="16" />
            <column datatype="real" name="flagged_sales_k" ordinal="17" />
            <column datatype="real" name="expected_loss_k" ordinal="18" />
            <column datatype="real" name="top_tier_sales_k" ordinal="19" />
            <column datatype="real" name="quiet_lifetime_sales_k" ordinal="20" />
          </columns>
        </relation>
        <refresh increment-key="" incremental-updates="false" />
      </connection>
    </datasource>
