    <worksheet name="Cohort heatmap">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b0b0b" fontsize="13" bold="true">Cohort retention</run>
            <run fontcolor="#52514e" fontsize="10">   share of each monthly cohort ordering again k months after the first purchase</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Cohort retention" name="cohort" />
          </datasources>
          <datasource-dependencies datasource="cohort">
            <column datatype="date" name="[cohort_month]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[months_since_first_purchase]" role="dimension" type="ordinal" />
            <column datatype="real" name="[retention]" role="measure" type="quantitative" aggregation="Sum" />
            <column-instance column="[cohort_month]" derivation="Month-Trunc" name="[tmn:cohort_month:ok]" pivot="key" type="ordinal" />
            <column-instance column="[months_since_first_purchase]" derivation="None" name="[none:months_since_first_purchase:ok]" pivot="key" type="ordinal" />
            <column-instance column="[retention]" derivation="Avg" name="[avg:retention:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" value="*0%" field="[cohort].[avg:retention:qk]" />
            <format attr="font-size" value="9" field="[cohort].[avg:retention:qk]" />
          </style-rule>
        </style>
        <panes>
