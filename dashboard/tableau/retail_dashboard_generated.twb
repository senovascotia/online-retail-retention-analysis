        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="RFM segment shares" name="segments" />
          </datasources>
          <datasource-dependencies datasource="segments">
            <column datatype="integer" name="[revenue_rank]" role="dimension" type="ordinal" />
            <column datatype="string" name="[segment]" role="dimension" type="nominal" />
            <column datatype="string" name="[measure]" role="dimension" type="nominal" />
            <column datatype="real" name="[share_pct]" role="measure" type="quantitative" aggregation="Sum" />
            <column-instance column="[revenue_rank]" derivation="None" name="[none:revenue_rank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[segment]" derivation="None" name="[none:segment:nk]" pivot="key" type="nominal" />
            <column-instance column="[measure]" derivation="None" name="[none:measure:nk]" pivot="key" type="nominal" />
            <column-instance column="[share_pct]" derivation="Sum" name="[sum:share_pct:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[segments].[sum:share_pct:qk]" scope="cols" value="Share (%)" />
          </style-rule>
          <style-rule element="cell">
            <format attr="text-format" value="*0&quot;%&quot;" field="[segments].[sum:share_pct:qk]" />
          </style-rule>
          <style-rule element="label">
            <format attr="display" value="false" field="[segments].[none:revenue_rank:ok]" />
            <format attr="display" value="false" field="[segments].[none:measure:nk]" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" scope="rows" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[segments].[none:measure:nk]" />
              <text column="[segments].[sum:share_pct:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([segments].[none:revenue_rank:ok] / [segments].[none:segment:nk] / [segments].[none:measure:nk])</rows>
        <cols>[segments].[sum:share_pct:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Concentration">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b0b0b" fontsize="13" bold="true">Revenue concentration</run>
            <run fontcolor="#52514e" fontsize="10">   cumulative share of sales earned by the top share of customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Revenue concentration" name="conc" />
          </datasources>
          <datasource-dependencies datasource="conc">
            <column datatype="real" name="[sales_pct]" role="measure" type="quantitative" aggregation="Sum" />
            <column datatype="real" name="[customers_pct]" role="dimension" type="quantitative" />
            <column-instance column="[sales_pct]" derivation="Sum" name="[sum:sales_pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[customers_pct]" derivation="None" name="[none:customers_pct:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[conc].[sum:sales_pct:qk]" scope="rows" value="Share of sales (%)" />
            <format attr="title" class="0" field="[conc].[none:customers_pct:qk]" scope="cols" value="Share of customers, ranked by sales (%)" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#4e79a7" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[conc].[sum:sales_pct:qk]</rows>
        <cols>[conc].[none:customers_pct:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by silence">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b0b0b" fontsize="13" bold="true">Churn rises with silence</run>
            <run fontcolor="#52514e" fontsize="10">   no purchase in the next 161 days, by days since last purchase</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Churn by days silent" name="churn" />
          </datasources>
          <datasource-dependencies datasource="churn">
            <column datatype="real" name="[churned_pct]" role="measure" type="quantitative" aggregation="Sum" />
            <column datatype="integer" name="[sort_order]" role="dimension" type="ordinal" />
            <column datatype="string" name="[days_silent]" role="dimension" type="nominal" />
            <column-instance column="[churned_pct]" derivation="Sum" name="[sum:churned_pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[sort_order]" derivation="None" name="[none:sort_order:ok]" pivot="key" type="ordinal" />
            <column-instance column="[days_silent]" derivation="None" name="[none:days_silent:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[churn].[sum:churned_pct:qk]" scope="rows" value="Churned (%)" />
            <format attr="title" class="0" field="[churn].[none:days_silent:nk]" scope="cols" value="Days since last purchase" />
          </style-rule>
          <style-rule element="cell">
            <format attr="text-format" value="*0&quot;%&quot;" field="[churn].[sum:churned_pct:qk]" />
          </style-rule>
          <style-rule element="label">
            <format attr="display" value="false" field="[churn].[none:sort_order:ok]" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" scope="cols" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[churn].[sum:churned_pct:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#f28e2b" />
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[churn].[sum:churned_pct:qk]</rows>
        <cols>([churn].[none:sort_order:ok] / [churn].[none:days_silent:nk])</cols>
      </table>
    </worksheet>
    <worksheet name="Rule back-test">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b0b0b" fontsize="13" bold="true">Early-warning rules, back-tested</run>
            <run fontcolor="#52514e" fontsize="10">   precision = share of flagged who churned; recall = share of churners flagged (at other cutoffs recall is 45-76%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Early-warning rules" name="rules" />
          </datasources>
          <datasource-dependencies datasource="rules">
            <column datatype="integer" name="[Rank]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Rule]" role="dimension" type="nominal" />
            <column datatype="string" name="[Flagged]" role="dimension" type="nominal" />
            <column datatype="string" name="[Precision]" role="dimension" type="nominal" />
            <column datatype="string" name="[Recall]" role="dimension" type="nominal" />
            <column datatype="string" name="[Churner revenue caught]" role="dimension" type="nominal" />
            <column-instance column="[Rank]" derivation="None" name="[none:Rank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Rule]" derivation="None" name="[none:Rule:nk]" pivot="key" type="nominal" />
            <column-instance column="[Flagged]" derivation="None" name="[none:Flagged:nk]" pivot="key" type="nominal" />
            <column-instance column="[Precision]" derivation="None" name="[none:Precision:nk]" pivot="key" type="nominal" />
            <column-instance column="[Recall]" derivation="None" name="[none:Recall:nk]" pivot="key" type="nominal" />
            <column-instance column="[Churner revenue caught]" derivation="None" name="[none:Churner revenue caught:nk]" pivot="key" type="nominal" />
            <column-instance column="[Rank]" derivation="Sum" name="[sum:Rank:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" value="*;;;" field="[rules].[sum:Rank:qk]" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" value="270" field="[rules].[none:Rule:nk]" />
            <format attr="width" value="170" field="[rules].[none:Churner revenue caught:nk]" />
            <format attr="width" value="80" field="[rules].[none:Flagged:nk]" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[rules].[sum:Rank:qk]" />
            </encodings>
            <style />
          </pane>
        </panes>
        <rows>([rules].[none:Rank:ok] / [rules].[none:Rule:nk] / [rules].[none:Flagged:nk] / [rules].[none:Precision:nk] / [rules].[none:Recall:nk] / [rules].[none:Churner revenue caught:nk])</rows>
        <cols />
      </table>
    </worksheet>
    <worksheet name="Contact list">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b0b0b" fontsize="13" bold="true">Top-value customers to contact first</run>
            <run fontcolor="#52514e" fontsize="10">   highest trailing 12m sales among customers silent 90+ days (as of 10 Dec 2011)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Contact list" name="contacts" />
          </datasources>
          <datasource-dependencies datasource="contacts">
            <column datatype="integer" name="[Rank]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Customer]" role="dimension" type="nominal" />
            <column datatype="integer" name="[Days silent]" role="dimension" type="ordinal" />
            <column datatype="real" name="[Own avg gap days]" role="dimension" type="nominal" />
            <column datatype="integer" name="[Order days]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Trailing 12m sales]" role="dimension" type="nominal" />
            <column datatype="string" name="[Early flag]" role="dimension" type="nominal" />
            <column-instance column="[Rank]" derivation="None" name="[none:Rank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Customer]" derivation="None" name="[none:Customer:nk]" pivot="key" type="nominal" />
            <column-instance column="[Days silent]" derivation="None" name="[none:Days silent:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Own avg gap days]" derivation="None" name="[none:Own avg gap days:nk]" pivot="key" type="nominal" />
            <column-instance column="[Order days]" derivation="None" name="[none:Order days:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Trailing 12m sales]" derivation="None" name="[none:Trailing 12m sales:nk]" pivot="key" type="nominal" />
            <column-instance column="[Early flag]" derivation="None" name="[none:Early flag:nk]" pivot="key" type="nominal" />
            <column-instance column="[Rank]" derivation="Sum" name="[sum:Rank:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" value="*;;;" field="[contacts].[sum:Rank:qk]" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" value="95" field="[contacts].[none:Days silent:ok]" />
            <format attr="width" value="140" field="[contacts].[none:Own avg gap days:nk]" />
            <format attr="width" value="100" field="[contacts].[none:Order days:ok]" />
            <format attr="width" value="150" field="[contacts].[none:Trailing 12m sales:nk]" />
            <format attr="width" value="90" field="[contacts].[none:Early flag:nk]" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[contacts].[sum:Rank:qk]" />
            </encodings>
            <style />
          </pane>
        </panes>
        <rows>([contacts].[none:Rank:ok] / [contacts].[none:Customer:nk] / [contacts].[none:Days silent:ok] / [contacts].[none:Own avg gap days:nk] / [contacts].[none:Order days:ok] / [contacts].[none:Trailing 12m sales:nk] / [contacts].[none:Early flag:nk])</rows>
        <cols />
      </table>
    </worksheet>
    <worksheet name="Recommendations">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#0b0b0b" fontsize="13" bold="true">Recommendations, ranked by value for effort</run>
            <run fontcolor="#52514e" fontsize="10">   annual impact under low / mid / high scenarios (scenario percentages are assumptions)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Recommendations" name="recs" />
          </datasources>
          <datasource-dependencies datasource="recs">
            <column datatype="integer" name="[Rank]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Action]" role="dimension" type="nominal" />
            <column datatype="string" name="[Effort]" role="dimension" type="nominal" />
            <column datatype="string" name="[Measured base]" role="dimension" type="nominal" />
            <column datatype="string" name="[Low]" role="dimension" type="nominal" />
            <column datatype="string" name="[Mid]" role="dimension" type="nominal" />
            <column datatype="string" name="[High]" role="dimension" type="nominal" />
            <column-instance column="[Rank]" derivation="None" name="[none:Rank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Action]" derivation="None" name="[none:Action:nk]" pivot="key" type="nominal" />
            <column-instance column="[Effort]" derivation="None" name="[none:Effort:nk]" pivot="key" type="nominal" />
            <column-instance column="[Measured base]" derivation="None" name="[none:Measured base:nk]" pivot="key" type="nominal" />
            <column-instance column="[Low]" derivation="None" name="[none:Low:nk]" pivot="key" type="nominal" />
            <column-instance column="[Mid]" derivation="None" name="[none:Mid:nk]" pivot="key" type="nominal" />
            <column-instance column="[High]" derivation="None" name="[none:High:nk]" pivot="key" type="nominal" />
            <column-instance column="[Rank]" derivation="Sum" name="[sum:Rank:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" value="*;;;" field="[recs].[sum:Rank:qk]" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" value="640" field="[recs].[none:Action:nk]" />
            <format attr="width" value="120" field="[recs].[none:Effort:nk]" />
            <format attr="width" value="130" field="[recs].[none:Measured base:nk]" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[recs].[sum:Rank:qk]" />
            </encodings>
            <style />
          </pane>
        </panes>
        <rows>([recs].[none:Rank:ok] / [recs].[none:Action:nk] / [recs].[none:Effort:nk] / [recs].[none:Measured base:nk] / [recs].[none:Low:nk] / [recs].[none:Mid:nk] / [recs].[none:High:nk])</rows>
        <cols />
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Overview">
      <size maxheight="1010" maxwidth="1280" minheight="1010" minwidth="1280" />
      <datasources>
        <datasource caption="Headline KPIs" name="kpis" />
        <datasource caption="Monthly sales" name="monthly" />
        <datasource caption="Existing vs new customers" name="newret" />
      </datasources>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="6337" id="2" w="100000" x="0" y="0" type="text">
            <formatted-text>
              <run fontsize="17" fontcolor="#ffffff" bold="true">  Sales are flat while new-customer acquisition fell 41%
</run>
              <run fontsize="9" fontcolor="#c9d1e3">  Online Retail II  ·  Overview  ·  Dec 2009 to 9 Dec 2011</run>
            </formatted-text>
            <zone-style>
              <format attr="background-color" value="#1f2a44" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="0" />
            </zone-style>
          </zone>
          <zone h="14851" id="3" w="28125" x="0" y="6337" name="T Gross sales" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="14851" id="4" w="17969" x="28125" y="6337" name="T Tracked customers" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="14851" id="5" w="17969" x="46094" y="6337" name="T Repeat rate" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="14851" id="6" w="17969" x="64062" y="6337" name="T Sales growth" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="14851" id="7" w="17969" x="82031" y="6337" name="T New customers" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="36634" id="8" w="100000" x="0" y="21188" name="Monthly sales" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="41188" id="9" w="54688" x="0" y="57822" name="New vs returning" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="41188" id="10" w="45312" x="54688" y="57822" type="text">
            <formatted-text>
              <run fontsize="14" fontcolor="#0b0b0b" bold="true">Key insights
</run>
              <run fontsize="11" fontcolor="#52514e">• Sales are flat (+1.9% on the same months a year earlier), but not because customers leave after one order: 72% reorder.
</run>
              <run fontsize="11" fontcolor="#52514e">• New-customer acquisition fell 41% (Jun-Nov 2011 vs 2010). Cohort quality has been stable since mid-2010, so volume is the part to investigate.
</run>
              <run fontsize="11" fontcolor="#52514e">• Revenue is concentrated: the top 10% of customers bring 64% of sales; RFM Champions (24% of customers) bring 70%.
</run>
              <run fontsize="11" fontcolor="#52514e">• Silence is the churn signal, not slowing gaps or cancellations. A 90-day rule flags 1,365 customers worth £809K in trailing sales.
</run>
              <run fontsize="11" fontcolor="#52514e">• Leaks: cancellations are 7.1% of gross sales; 15% of sales have no customer ID.</run>
            </formatted-text>
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone-style>
            <format attr="background-color" value="#f3f4f6" />
          </zone-style>
        </zone>
      </zones>
    </dashboard>
    <dashboard name="Retention">
      <size maxheight="1090" maxwidth="1280" minheight="1090" minwidth="1280" />
      <datasources>
        <datasource caption="Cohort retention" name="cohort" />
        <datasource caption="New customers by region" name="region" />
        <datasource caption="90-day repeat rate" name="repeat" />
      </datasources>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="5872" id="2" w="100000" x="0" y="0" type="text">
            <formatted-text>
              <run fontsize="17" fontcolor="#ffffff" bold="true">  Cohort quality is stable since mid-2010; acquisition volume is what fell
</run>
              <run fontsize="9" fontcolor="#c9d1e3">  Online Retail II  ·  Retention  ·  Dec 2009 to 9 Dec 2011</run>
            </formatted-text>
            <zone-style>
              <format attr="background-color" value="#1f2a44" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="0" />
            </zone-style>
          </zone>
          <zone h="59633" id="3" w="100000" x="0" y="5872" name="Cohort heatmap" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="33578" id="4" w="34375" x="0" y="65505" name="Repeat 90d" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="33578" id="5" w="37500" x="34375" y="65505" name="New customers by region" show-title="true">
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="33578" id="6" w="28125" x="71875" y="65505" type="text">
            <formatted-text>
              <run fontsize="14" fontcolor="#0b0b0b" bold="true">What to notice
</run>
              <run fontsize="11" fontcolor="#52514e">• About 20% of every 2010-2011 cohort orders again in month 1; the 90-day repeat rate fell from 45% (2010 H1) to about 41% and then held.
</run>
              <run fontsize="11" fontcolor="#52514e">• Activity is seasonal: cohorts light up again when the Sep-Nov peak returns.
</run>
              <run fontsize="11" fontcolor="#52514e">• New customers fell 41% (Jun-Nov 2011 vs 2010); UK arrivals dropped 43%.
</run>
              <run fontsize="11" fontcolor="#52514e">• The 2009 Dec cohort is overstated: it includes people who bought before the data starts.</run>
            </formatted-text>
            <zone-style>
              <format attr="background-color" value="#ffffff" />
              <format attr="border-color" value="#dfe2e8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone-style>
            <format attr="background-color" value="#f3f4f6" />
          </zone-style>
        </zone>
      </zones>
    </dashboard>
